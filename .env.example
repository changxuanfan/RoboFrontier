# Copy to .env (mode 0600), then fill in only the providers you use.
# Never commit credentials. Existing process environment variables take precedence.

# --- Codex harness ------------------------------------------------------------
# API models (sol, the default; luna). Subscription models (sol_subscription, ...) use
# the login in ~/.roboteam/codex-home instead: CODEX_HOME=~/.roboteam/codex-home codex login
OPENAI_API_KEY=
# Local key of the Codex/Claude loopback gateway (opus_claude_api). Not an Anthropic key:
# that one stays with the gateway process (docs/harness/claude-in-codex.md).
ROBOTEAM_CLAUDE_GATEWAY_KEY=
# Local key of the Claude Code/GPT loopback gateway (docs/harness/gpt-in-claude-code.md).
ROBOTEAM_CHATGPT_GATEWAY_KEY=

# --- Claude harness -----------------------------------------------------------
# API models (opus, the default; haiku).
ANTHROPIC_API_KEY=
# Subscription models (opus_subscription, haiku_subscription_token): generate with the
# official `claude setup-token` flow and store the one-year token here.
# Select haiku_subscription for saved-login authentication instead.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Third-party providers (both harnesses) -------------------------------------
DEEPSEEK_API_KEY=
ZAI_API_KEY=
KIMI_API_KEY=
# Separate Kimi Code account/key; not interchangeable with the Moonshot API key.
KIMI_CODE_API_KEY=
DASHSCOPE_API_KEY=
# Endpoints for your account/region: Responses (Codex) and Anthropic-compatible (Claude).
DASHSCOPE_BASE_URL=
DASHSCOPE_ANTHROPIC_BASE_URL=
