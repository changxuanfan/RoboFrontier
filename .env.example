# Copy to .env (mode 0600), then fill in only the providers you use.
# Never commit credentials. Existing process environment variables take precedence.

# --- Codex engine ------------------------------------------------------------
# API profiles (luna, ...). Subscription profiles (luna_subscription) use the
# login in ~/.robofrontier/codex-home instead: CODEX_HOME=~/.robofrontier/codex-home codex login
OPENAI_API_KEY=
# OpenLux token must be configured for the desired group in its console.
OPENLUX_API_KEY=

# --- Claude engine -----------------------------------------------------------
# API profile (haiku).
ANTHROPIC_API_KEY=
# Default subscription profile (haiku_subscription_token): generate with the
# official `claude setup-token` flow and store the one-year token here.
# Select haiku_subscription for saved-login authentication instead.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Antigravity engine ------------------------------------------------------
# flash_subscription uses a Google login on the execution host; no API key.
# flash_api uses the Gemini API. Real keys stay in the trusted host relay.
GEMINI_API_KEY=
# flash_service expects a Gemini-compatible service, with an HTTPS root URL.
ANTIGRAVITY_SERVICE_BASE_URL=
ANTIGRAVITY_SERVICE_API_KEY=

# --- Third-party providers (both engines) -------------------------------------
DEEPSEEK_API_KEY=
ZAI_API_KEY=
KIMI_API_KEY=
# Separate Kimi Code account/key; not interchangeable with the Moonshot API key.
KIMI_CODE_API_KEY=
DASHSCOPE_API_KEY=
# Endpoints for your account/region: Responses (Codex) and Anthropic-compatible (Claude).
DASHSCOPE_BASE_URL=
DASHSCOPE_ANTHROPIC_BASE_URL=
