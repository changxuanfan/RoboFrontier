__pycache__/
*.pyc
.DS_Store
.pytest_cache/
.robot-bridge.json

# Local data and runtime state. No trailing slash, so these also match the
# symlinks that worktree checkouts use in place of the folders.
/.venv
/.venv-gateway
/vendor
/runs
/outputs
/docs/generated
/configs/evaluations/private
/.codex-tools/
/.roboteam/
/.claude/
/MUJOCO_LOG.TXT

# Credentials stay local; only the templates are tracked.
/.env
/.env.*
!/.env.example

# Large environment assets and previews are materialized per worktree.
/benchmark/*/*/assets/
/benchmark/*/*/preview-*.png
/benchmark/*/*/FROZEN

# Project page: local encoded media and design explorations (media is published to its own repository)
/site/_media/
/site/_directions/
/site/_dev/

# Generated by roboteam.sim.hall.build on each build
/benchmark/hall/meshes/
# Factory textures sim/hall/build.py draws at build; the authored exterior image stays tracked.
/benchmark/hall/textures/*
!/benchmark/hall/textures/exterior-daylight-v1.png
!/benchmark/hall/textures/exterior-daylight-v1.prompt.txt
